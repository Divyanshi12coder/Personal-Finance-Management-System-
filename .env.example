# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://finpilot:finpilot_dev_password@localhost:5432/finpilot?schema=public

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── AI Coach (Anthropic) ──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
AI_COACH_MODEL=claude-sonnet-4-6
AI_COACH_CACHE_TTL_SECONDS=3600

# ── Receipt Storage (S3-compatible / MinIO) ──────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=finpilot
S3_SECRET_KEY=finpilot_dev_password
S3_BUCKET=finpilot-receipts
S3_REGION=us-east-1

# ── OCR ───────────────────────────────────────────────────
OCR_PROVIDER=tesseract   # tesseract | cloud-vision

# ── App ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
DEFAULT_CURRENCY=INR

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
